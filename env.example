# Copy this file to .env and fill in the values you want to change.
# For real Gemini generation, provide a Google AI Studio API key.
GEMINI_API_KEY=

# Current defaults use a production-ready Flash model for both tasks.
# You can change these to another model available to your API key.
WORKOUT_MODEL=gemini-3.8-flash
NUTRITION_MODEL=gemini-3.8-flash

# Set true to force deterministic local demo responses without calling Gemini.
MOCK_AI=false

# Optional: protect the admin dashboard and delete endpoint with a query-string key.
# ADMIN_KEY=

ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./data/fitbuddy.db
